{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "edgemetry",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-28",
  "compatibility_flags": ["nodejs_compat"],

  // Observability is on so `wrangler tail` and the dashboard's Logs view work
  // out of the box. Drop head_sampling_rate if your traffic grows a lot.
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },

  // D1 is the only resource this Worker needs.
  //
  // `database_id` is deliberately absent. Omitting it is what opts into
  // automatic provisioning: both the "Deploy to Cloudflare" button and a plain
  // `wrangler deploy` will create the database on first deploy and write the
  // real id back here. A placeholder id would NOT provision anything — it would
  // try to bind a database that does not exist and fail.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "edgemetry"
    }
  ],

  "triggers": {
    // :05 past the hour — roll the completed hour into stats_hourly.
    // 00:20 UTC — roll yesterday into stats_daily, then drop its raw tables.
    "crons": ["5 * * * *", "20 0 * * *"]
  },

  // Note: the dashboard ships inside the Worker bundle rather than as static
  // assets — one less thing for the deploy button to wire up, and it keeps every
  // route under our own control instead of the asset router's. No module rule is
  // needed; Wrangler already imports *.html as a Text module by default.

  "vars": {
    // Days of hourly rollups to keep. Daily rollups are kept forever.
    "HOURLY_RETENTION_DAYS": "7",
    // The filter cube — one rollup row per distinct combination of dimensions
    // per day — is what lets the dashboard narrow every panel at once. Its cost
    // scales with how *varied* your traffic is, not how much of it there is.
    // Set to "off" on an unusually diverse instance to trade filtering for a
    // smaller write budget.
    "FILTERS": "on",
    // PBKDF2 iterations for the admin password. The Workers *free* plan caps
    // CPU at 10ms per request, which is why this is not the usual 100k+.
    // On the $5/mo paid plan you can safely raise this to 200000.
    "PBKDF2_ITERATIONS": "15000",
    // Once a day, beside the nightly rollup, the Worker asks GitHub for the
    // newest Edgemetry release and stores the answer so the account menu can
    // say whether this instance is behind. It is the only request this project
    // makes to anyone, it happens on a cron rather than in anybody's browser,
    // and it says nothing about you beyond the version it is asking about.
    // Set to "off" to never make it — updates then become something you go
    // looking for. See the update workflow under .github/workflows.
    "UPDATE_CHECK": "on"
  }

  // Note: the URL the dashboard prints in its install snippet is deliberately
  // *not* a var. It is only knowable after the first deploy — it depends on the
  // hostname you landed on, the filename you picked for the tracker, and
  // whether you later split the dashboard onto its own hostname behind Access.
  // Asking for it here would mean a required field with no answer yet, so it
  // lives under Install & sites in the dashboard instead.
}
